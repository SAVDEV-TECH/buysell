rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profiles
    match /users/{userId} {
      // Allow owners, admins, and public manufacturer profiles to be read.
      allow read: if (
        request.auth == null && resource.data.role == 'MANUFACTURER' && resource.data.isPublic == true
      ) || (
        request.auth != null && (
          request.auth.uid == userId ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN') ||
          (resource.data.role == 'MANUFACTURER' && resource.data.isPublic == true)
        )
      );

      // Secure creation: user can create their own doc, but must start as non-admin, non-verified
      allow create: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.role in ['WHOLESALER', 'MANUFACTURER', 'BUYER'] &&
        request.resource.data.isVerified == false;

      // Secure updates: user can update their details, but CANNOT alter 'role' or 'isVerified' keys
      allow update: if request.auth != null && (
        (request.auth.uid == userId && 
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isVerified'])) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN'
      );

      // Only admins can delete user profiles
      allow delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
    }

    // Products
    match /products/{productId} {
      // Products are publicly readable
      allow read: if true;
      
      // Create: authenticated seller/owner can publish a product
      allow create: if request.auth != null &&
        (request.auth.uid == request.resource.data.sellerId || request.auth.uid == request.resource.data.manufacturerId) &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['MANUFACTURER', 'WHOLESALER'] &&
        request.resource.data.price is number &&
        request.resource.data.price > 0 &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.description is string;
      
      // Update: seller/manufacturer who created it or admins
      allow update: if request.auth != null && (
        ((request.auth.uid == resource.data.sellerId || request.auth.uid == resource.data.manufacturerId) &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['sellerId', 'manufacturerId', 'createdAt']) &&
         request.resource.data.price > 0) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN')
      );
      
      // Delete: seller/manufacturer who created it or admins
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.sellerId ||
        request.auth.uid == resource.data.manufacturerId ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN')
      );
    }

    // Chats & Messages
    match /chats/{chatId} {
      // Allow participants to read and update the chat document
      allow read, update: if request.auth != null && 
        request.auth.uid in resource.data.participants;
      
      // Allow creation of a chat if the creator is one of the participants
      allow create: if request.auth != null && 
        request.auth.uid in request.resource.data.participants &&
        request.resource.data.participants.size() >= 2;
      
      // Only admins can delete chats
      allow delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
    }

    match /messages/{messageId} {
      // Allow reading messages if the user is a participant in the associated chat
      allow read: if request.auth != null && 
        request.auth.uid in get(/databases/$(database)/documents/chats/$(resource.data.chatId)).data.participants;
      
      // Allow creating a message if the user is a participant in the associated chat
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.senderId &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.participants &&
        request.resource.data.text != null &&
        request.resource.data.text.size() > 0;
      
      // Messages are immutable (no updates)
      allow update: if false;
      
      // Only admins can delete messages
      allow delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
    }

    // Orders
    match /orders/{orderId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.buyerId ||
        request.auth.uid == resource.data.wholesalerId ||
        request.auth.uid == resource.data.sellerId ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN')
      );
      
      // Only the buyer/wholesaler can create orders (must be authenticated user)
      allow create: if request.auth != null &&
        (request.auth.uid == request.resource.data.buyerId || request.auth.uid == request.resource.data.wholesalerId) &&
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['WHOLESALER', 'BUYER']) &&
        request.resource.data.totalAmount > 0 &&
        request.resource.data.items != null;
      
      // Update: seller can update status/fulfillment, buyer/wholesaler can update limited fields, admin can do anything
      allow update: if request.auth != null && (
        (request.auth.uid == resource.data.sellerId && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'shippingInfo', 'updatedAt', 'trackingNumber'])) ||
        ((request.auth.uid == resource.data.buyerId || request.auth.uid == resource.data.wholesalerId) && 
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['sellerId', 'buyerId', 'wholesalerId', 'totalAmount', 'items'])) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN')
      );
      
      // Only admins can delete orders
      allow delete: if request.auth != null &&
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN');
    }

    // Payout Requests
    match /payoutRequests/{requestId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN'
      );
      
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.userId &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'MANUFACTURER' &&
        request.resource.data.amount > 0 &&
        request.resource.data.amount <= 10000000 &&
        request.resource.data.bankAccount != null &&
        request.resource.data.bankAccount.size() > 0;
      
      // Both user and admin can update (user to cancel, admin to process)
      allow update: if request.auth != null && (
        (request.auth.uid == resource.data.userId && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt'])) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN'
      );
      
      // Only admins can delete
      allow delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
    }

    // RFQs (Request For Quotes)
    match /rfqs/{rfqId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.wholesalerId || 
        request.auth.uid == resource.data.manufacturerId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN'
      );
      
      // Only wholesalers can create RFQs
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.wholesalerId &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'WHOLESALER' &&
        request.resource.data.quantity > 0 &&
        request.resource.data.productId != null;
      
      // Wholesaler can update their side, manufacturer can update quote/status
      allow update: if request.auth != null && (
        (request.auth.uid == resource.data.wholesalerId && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity', 'deadline', 'notes', 'updatedAt'])) ||
        (request.auth.uid == resource.data.manufacturerId && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quotePrice', 'quoteQuantity', 'status', 'notes', 'updatedAt'])) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN'
      );
      
      // Only admins can delete
      allow delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
    }

    // Notifications
    match /notifications/{notificationId} {
      // Only recipient can read their notifications
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      
      // Only systems can create notifications (admin or server-side validation needed)
      allow create: if request.auth != null && (
        request.auth.uid == request.resource.data.userId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN'
      ) &&
        request.resource.data.type in ['ORDER', 'MESSAGE', 'PAYMENT', 'RFQ', 'SYSTEM'];
      
      // Only recipient can update their notifications (mark as read)
      allow update: if request.auth != null && 
        request.auth.uid == resource.data.userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'updatedAt']);
      
      // Only recipient can delete their notifications
      allow delete: if request.auth != null && 
        request.auth.uid == resource.data.userId;
    }

    // Audit Logs (read-only for users, write for system)
    match /auditLogs/{logId} {
      allow read: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
      
      allow create: if request.auth != null;
      
      allow update, delete: if false;
    }

    // Login Attempts (for rate limiting)
    // Only server-side Cloud Functions can write to this collection
    match /loginAttempts/{email} {
      // No direct user read access
      allow read: if false;
      
      // Only server-side functions can write
      allow create, update: if false;
      
      allow delete: if false;
    }

    // Transactions (payment records)
    match /transactions/{transactionId} {
      // Users can read their own transactions
      allow read: if request.auth != null && 
        resource.data.userId == request.auth.uid;
      
      // Server-side actions create transactions
      allow create: if request.auth != null;
      
      // Only admin can update
      allow update: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
      
      allow delete: if false;
    }

    // Escrow documents - controls payments held in escrow between buyer/manufacturer/wholesaler
    match /escrows/{escrowId} {
      // Read: participants and admins only
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.buyerId ||
        request.auth.uid == resource.data.manufacturerId ||
        (resource.data.wholesalerId != null && request.auth.uid == resource.data.wholesalerId) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN')
      );

      // Create: buyer creates escrows
      allow create: if request.auth != null && validCreate(request.resource.data);

      // Update: participants or admin with rules enforced in validUpdate
      allow update: if request.auth != null && validUpdate(resource.data, request.resource.data);

      // Delete: admins only
      allow delete: if request.auth != null && (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN');

      function validCreate(data) {
        return
          data.orderId is string
          && data.buyerId is string
          && data.manufacturerId is string
          && data.amount is int && data.amount > 0
          && data.currency == 'NGN'
          && data.paymentMethod in ['paystack', 'bank_transfer']
          && data.status in ['pending_payment', 'awaiting_link']
          && data.buyerId == request.auth.uid
          && (data.wholesalerId == null || data.wholesalerId is string)
          && (data.paystackReference == null || data.paystackReference is string)
          && (data.paystackTransferCode == null)
          && (data.proofOfPaymentUrl == null || data.proofOfPaymentUrl is string)
          && data.timeline is map
          && data.timeline.orderedAt is timestamp
          && (data.timeline.fundedAt == null || data.timeline.fundedAt is timestamp)
          && (data.timeline.shippedAt == null || data.timeline.shippedAt is timestamp)
          && (data.disputeReason == null || data.disputeReason is string)
          && (data.disputeEvidence == null || (data.disputeEvidence is list && data.disputeEvidence.size() <= 10))
          && data.createdAt is timestamp
          && data.updatedAt is timestamp;
      }

      function allowedStatusTransition(oldStatus, newStatus, actorIsBuyer, actorIsManufacturer, actorIsAdmin) {
        return oldStatus == newStatus || (
          (oldStatus == 'pending_payment' && newStatus == 'awaiting_link' && actorIsBuyer) ||
          ((oldStatus == 'pending_payment' || oldStatus == 'awaiting_link') && newStatus == 'funded' && actorIsAdmin) ||
          (oldStatus == 'funded' && newStatus == 'shipped' && actorIsManufacturer) ||
          (oldStatus == 'shipped' && newStatus == 'released' && actorIsAdmin) ||
          (oldStatus == 'funded' && newStatus == 'refunded' && actorIsAdmin) ||
          (newStatus == 'disputed' && (actorIsBuyer || actorIsManufacturer))
        );
      }

      function validUpdate(oldData, newData) {
        // immutable fields
        let immutableUnchanged = newData.orderId == oldData.orderId
          && newData.buyerId == oldData.buyerId
          && newData.manufacturerId == oldData.manufacturerId
          && newData.amount == oldData.amount
          && newData.currency == oldData.currency
          && (oldData.createdAt == null || newData.createdAt == oldData.createdAt);

        if (!immutableUnchanged) { return false; }

        let actorIsBuyer = request.auth.uid == oldData.buyerId;
        let actorIsManufacturer = request.auth.uid == oldData.manufacturerId;
        let actorIsWholesaler = (oldData.wholesalerId != null && request.auth.uid == oldData.wholesalerId);
        let actorIsAdmin = (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN');

        if (!allowedStatusTransition(oldData.status, newData.status, actorIsBuyer, actorIsManufacturer, actorIsAdmin)) {
          return false;
        }

        // server-only
        if (newData.paystackTransferCode != oldData.paystackTransferCode && !actorIsAdmin) { return false; }

        if (newData.paystackReference != oldData.paystackReference && !(actorIsBuyer || actorIsAdmin)) { return false; }

        if (newData.proofOfPaymentUrl != oldData.proofOfPaymentUrl && !actorIsBuyer) { return false; }

        if (oldData.status != 'funded' && newData.status == 'funded') {
          if (!(newData.timeline.fundedAt is timestamp)) { return false; }
          if (!actorIsAdmin) { return false; }
        }

        if (oldData.status != 'shipped' && newData.status == 'shipped') {
          if (!(newData.timeline.shippedAt is timestamp)) { return false; }
          if (!actorIsManufacturer) { return false; }
        }

        if ((newData.status == 'released' || newData.status == 'refunded') && !actorIsAdmin) { return false; }

        if (newData.status == 'disputed') {
          if (!(newData.disputeReason is string && newData.disputeReason.size() > 0)) { return false; }
          if (newData.disputeEvidence != null) {
            if (!(newData.disputeEvidence is list && newData.disputeEvidence.size() <= 10)) { return false; }
            if (!newData.disputeEvidence.reduce((acc, e) => acc && (e is string), true)) { return false; }
          }
        }

        if (newData.timeline.autoReleaseAt != null && newData.timeline.fundedAt != null) {
          if (!(newData.timeline.autoReleaseAt is timestamp && newData.timeline.fundedAt is timestamp)) { return false; }
          if (!(newData.timeline.autoReleaseAt >= newData.timeline.fundedAt)) { return false; }
        }

        if (!(newData.updatedAt is timestamp)) { return false; }

        if (!(newData.amount is int && newData.amount > 0)) { return false; }

        return true;
      }
    }
  }
}
